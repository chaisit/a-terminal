<?xml version="1.0" encoding="utf-8"?>
<!-- T1: glyph ">_" สไตล์ prompt — vector ล้วน ไม่มี PNG; viewport 108dp, safe zone วงกลม r=33 ตรงกลาง
     (ทุกจุดของ glyph อยู่ภายใน r≈26 จาก centre — ไม่โดน mask ตัดบน launcher ทุกรูปทรง) -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- prompt chevron ">" -->
    <path
        android:pathData="M38,42 L52,54 L38,66"
        android:strokeColor="#16C60C"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- cursor underscore -->
    <path
        android:pathData="M58,66 L76,66"
        android:strokeColor="#16C60C"
        android:strokeWidth="7"
        android:strokeLineCap="round" />
</vector>
